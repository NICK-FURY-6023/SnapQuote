{
  "name": "snapquote",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "build:dev": "eas build --profile development --platform android",
    "build:prod": "eas build --profile production --platform android",
    "update:staging": "eas update --branch staging --message",
    "update:prod": "eas update --branch production --message"
  },
  "dependencies": {
    "expo": "~55.0.4",
    "expo-router": "~4.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-linking": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-secure-store": "~55.0.8",
    "expo-local-authentication": "~15.0.0",
    "expo-blur": "~55.0.8",
    "expo-linear-gradient": "~55.0.8",
    "expo-camera": "~55.0.9",
    "expo-file-system": "~55.0.10",
    "expo-print": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-haptics": "~14.0.0",
    "expo-sqlite": "~55.0.10",
    "expo-font": "~13.0.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-web": "^0.21.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-worklets": "0.7.2",
    "@react-navigation/native": "^7.1.33",
    "@expo/vector-icons": "^14.0.0",
    "firebase": "^11.0.0",
    "zustand": "^5.0.11",
    "zod": "^3.24.0",
    "@react-native-community/netinfo": "11.5.2",
    "react-native-uuid": "^2.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2",
    "vitest": "^3.0.0",
    "eslint": "^9.0.0"
  },
  "private": true
}
