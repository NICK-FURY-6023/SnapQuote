{
  "expo": {
    "name": "SnapQuote",
    "slug": "snapquote",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "snapquote",
    "splash": {
      "backgroundColor": "#0a0e27",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nickfury.snapquote",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapQuote uses your camera to scan product photos for automatic quotation generation.",
        "NSFaceIDUsageDescription": "SnapQuote uses Face ID to unlock the app securely."
      }
    },
    "android": {
      "package": "com.nickfury.snapquote",
      "adaptiveIcon": {
        "backgroundColor": "#0a0e27",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "SnapQuote needs camera access to scan products for quotations."
        }
      ],
      [
        "expo-blur",
        {
          "reduceTransparencyFallbackColor": "#0a0e27"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0bfc33b-1141-4130-8c6e-79877d3f5cbf"
      }
    },
    "owner": "snapquote"
  }
}
